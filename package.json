{
  "name": "blog-ai",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "init": "npm install && npm run env:setup",
    "init:setup": "npm run docker:up && npm run migrate:up",
    "env:setup": "cp -n .env.example .env.local && cp -n .env.example .env.test",
    "dev": "node --env-file=.env.local --watch src/index.js",
    "docker:build": "docker build -t blog-ia-nodejs:latest .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose stop postgres",
    "migrate:up": "node --env-file=.env.local node_modules/.bin/postgrator migrate",
    "migrate:down": "node --env-file=.env.local node_modules/.bin/postgrator migrate 0",
    "commit": "node scripts/commit.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test ./tests/unit/**/*.test.js",
    "test:integration": "node --test --env-file=.env.test tests/integration/**/*.test.js",
    "test:e2e": "node --test --env-file=.env.test tests/e2e/**/*.test.js"
  },
  "dependencies": {
    "@mastra/core": "^1.65.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "supertest": "^7.2.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@inquirer/prompts": "^8.7.2",
    "lefthook": "^2.1.12",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "postgrator-cli": "^10.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
