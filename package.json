{
  "name": "blog-ai",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "init": "npm install && npm run env:setup",
    "dev": "node --env-file=.env.local --watch src/index.js",
    "env:setup": "cp .env.exemple .env.local",
    "init:setup": "npm run infra:up && npm run migrate:up",
    "migrate:up": "node --env-file=.env.local node_modules/.bin/postgrator migrate",
    "migrate:down": "node --env-file=.env.local node_modules/.bin/postgrator migrate 0",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "commit": "node scripts/commit.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mastra/core": "^1.65.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@inquirer/prompts": "^8.7.2",
    "lefthook": "^2.1.12",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "postgrator-cli": "^10.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
